# =====================================================================
#  🔑  AI CHAT ASSISTANT — BACKEND CONFIG
#  Copy this file to `.env` (same folder) and fill in your values.
#  After changing anything here, restart the backend.
# =====================================================================

# ---------------------------------------------------------------------
#  1) CHOOSE YOUR AI PROVIDER   →   openai | claude | mock
#     "mock" = no API key needed (fake streaming reply, for testing UI)
# ---------------------------------------------------------------------
AI_PROVIDER=openai

# ---------------------------------------------------------------------
#  2) OPENAI  (used when AI_PROVIDER=openai)
#     Get a key: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (Groq, OpenRouter, Azure, local LLM…)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------
#  3) CLAUDE / ANTHROPIC  (used when AI_PROVIDER=claude)
#     Get a key: https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_ANTHROPIC_KEY
CLAUDE_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------------
#  Generation settings (optional)
# ---------------------------------------------------------------------
MAX_TOKENS=1024
TEMPERATURE=0.7
# How many previous Q&A pairs are sent to the model as context
MAX_HISTORY_EXCHANGES=20

# ---------------------------------------------------------------------
#  Server & database
# ---------------------------------------------------------------------
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_chat_assistant
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ai_chat_assistant
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
